#!/bin/sh
# Rebuilds the blog (post pages, feed.xml, sitemap.xml) whenever a commit
# touches blog/posts/, the page template, the filters or build.js, and adds the results
# to the same commit. If the build fails, the commit is stopped.
#
# Turn it on once per clone of the repo:
#   git config core.hooksPath .githooks

# Git apps on macOS often run hooks without Homebrew on the PATH.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

if git diff --cached --name-only | grep -qE '^(blog/posts/|blog/template\.html$|blog/filters\.lua$|build\.js$)'; then
  command -v node >/dev/null 2>&1 || { echo "pre-commit: node not found"; exit 1; }
  echo "pre-commit: rebuilding blog..."
  node build.js || { echo "pre-commit: build failed, commit stopped."; exit 1; }
  git add -A -- feed.xml sitemap.xml ':(glob)blog/*.html'
fi
